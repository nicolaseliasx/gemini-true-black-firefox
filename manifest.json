{
  "manifest_version": 3,
  "name": "Gemini ChatGPT Black",
  "version": "0.1.0",
  "description": "Aplica ao Gemini a paleta preta do ChatGPT, sem alterar suas funções.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-chatgpt-black@ncls.cc",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["theme.css"],
      "js": ["theme.js"],
      "css_origin": "user",
      "run_at": "document_start"
    }
  ]
}
