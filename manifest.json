{
  "manifest_version": 3,
  "name": "Gemini True Black",
  "version": "0.2.6",
  "description": "A true black (OLED) dark theme for Gemini. Layout and features stay untouched.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-true-black@ncls.cc",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["theme.css"],
      "js": ["theme.js"],
      "css_origin": "user",
      "run_at": "document_start"
    }
  ]
}
